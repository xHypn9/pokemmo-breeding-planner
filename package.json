{
  "name": "pokemmo-breeding-planner",
  "version": "1.0.3",
  "description": "Offline, deterministic PokeMMO breeding inventory and planner",
  "main": "out/main/index.js",
  "author": "PokeMMO Breeding Planner contributors",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && electron-vite build",
    "dist": "node scripts/require-google-oauth.mjs && tsc --noEmit && electron-vite build && electron-builder --win nsis",
    "dist:without-cloud": "tsc --noEmit && electron-vite build && electron-builder --win nsis",
    "update-species-data": "tsx scripts/update-species-dataset.ts",
    "dataset:update": "tsx scripts/update-species-dataset.ts",
    "seed:demo": "tsx scripts/seed-development.ts",
    "demo:planner": "tsx scripts/planner-demo.ts",
    "demo:multilevel": "tsx scripts/planner-multilevel-demo.ts",
    "postinstall": "node node_modules/electron/install.js"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "@xyflow/react": "^12.11.3",
    "adm-zip": "^0.5.16",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.3",
    "tesseract.js": "^7.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "electron": "43.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "build": {
    "appId": "io.local.pokemmo.breedingplanner",
    "productName": "PokeMMO Breeding Planner",
    "asar": true,
    "asarUnpack": [
      "node_modules/tesseract.js/**",
      "node_modules/tesseract.js-core/**",
      "node_modules/sharp/**",
      "node_modules/@img/**"
    ],
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "node_modules/@tesseract.js-data/eng/4.0.0",
        "to": "ocr",
        "filter": ["eng.traineddata.gz"]
      }
    ],
    "win": {
      "target": "nsis",
      "artifactName": "PokeMMO-Breeding-Planner-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
